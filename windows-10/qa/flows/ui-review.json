{
  "id": "pdv-ui-review",
  "steps": [
    {
      "action": "waitFor",
      "selector": "a[href=\"#/caixa\"]",
      "name": "pdv-ready",
      "timeoutMs": 20000
    },
    {
      "action": "expectVisible",
      "text": "PDV Nexus",
      "exact": true,
      "name": "new-pdv-brand"
    },
    {
      "action": "expectVisible",
      "text": "Nova venda (F2)",
      "exact": true,
      "name": "initial-sale-cta-visible"
    },
    {
      "action": "expectVisible",
      "selector": "button[aria-label=\"Iniciar nova venda\"]",
      "name": "initial-sale-cta-accessible"
    },
    {
      "action": "waitFor",
      "selector": "[data-cashier-layout=\"dense-v2\"]",
      "name": "dense-cashier-layout",
      "timeoutMs": 5000
    },
    {
      "action": "expectVisible",
      "text": "VENDA (PDV)",
      "exact": true,
      "name": "cashier-operational-heading"
    },
    {
      "action": "waitFor",
      "selector": "[data-cashier-client-icon=\"true\"]",
      "name": "client-icon-visible",
      "timeoutMs": 5000
    },
    {
      "action": "waitFor",
      "selector": "[data-cashier-seller-icon=\"true\"]",
      "name": "seller-icon-visible",
      "timeoutMs": 5000
    },
    {
      "action": "waitFor",
      "selector": "[data-cashier-footer=\"sale-actions\"]",
      "name": "cashier-footer-visible",
      "timeoutMs": 5000
    },
    {
      "action": "expectVisible",
      "text": "Qtd. total",
      "exact": true,
      "name": "cashier-quantity-total"
    },
    {
      "action": "screenshot",
      "name": "01-caixa-rapido"
    },
    {
      "action": "click",
      "selector": "a[href=\"#/produtos\"]",
      "name": "open-produtos"
    },
    {
      "action": "expectURL",
      "includes": "#/produtos",
      "name": "produtos-route"
    },
    {
      "action": "waitForTimeout",
      "timeoutMs": 250,
      "name": "produtos-render"
    },
    {
      "action": "screenshot",
      "name": "02-produtos"
    },
    {
      "action": "expectVisible",
      "text": "Os 5 produtos iniciais são exemplos para conhecer o sistema. Você pode cadastrar quantos produtos precisar, sem limite de cinco.",
      "exact": true,
      "name": "example-products-not-limit"
    },
    {
      "action": "click",
      "text": "Novo produto",
      "exact": true,
      "name": "open-new-product-form"
    },
    {
      "action": "expectVisible",
      "text": "Cadastrar produto",
      "exact": true,
      "name": "product-create-visible"
    },
    {
      "action": "screenshot",
      "name": "02a-cadastro-de-produto"
    },
    {
      "action": "click",
      "text": "Recolher cadastro",
      "exact": true,
      "name": "close-product-form"
    },
    {
      "action": "click",
      "selector": "a[href=\"#/clientes\"]",
      "name": "open-clientes"
    },
    {
      "action": "expectURL",
      "includes": "#/clientes",
      "name": "clientes-route"
    },
    {
      "action": "waitForTimeout",
      "timeoutMs": 250,
      "name": "clientes-render"
    },
    {
      "action": "screenshot",
      "name": "03-clientes"
    },
    {
      "action": "click",
      "selector": "a[href=\"#/vendas\"]",
      "name": "open-financeiro"
    },
    {
      "action": "expectURL",
      "includes": "#/vendas",
      "name": "financeiro-route"
    },
    {
      "action": "waitForTimeout",
      "timeoutMs": 250,
      "name": "financeiro-render"
    },
    {
      "action": "expectVisible",
      "text": "Relatórios detalhados de vendas",
      "exact": true,
      "name": "sales-reports-visible"
    },
    {
      "action": "expectVisible",
      "text": "Exportar CSV detalhado",
      "exact": true,
      "name": "sales-reports-csv-visible"
    },
    {
      "action": "expectVisible",
      "text": "Exportar Excel (.xlsx)",
      "exact": true,
      "name": "sales-reports-xlsx-visible"
    },
    {
      "action": "expectVisible",
      "text": "Exportar PDF",
      "exact": true,
      "name": "sales-reports-pdf-visible"
    },
    {
      "action": "expectVisible",
      "selector": ".nexus-reports__extras",
      "name": "sales-reports-favorites-visible"
    },
    {
      "action": "expectVisible",
      "selector": ".nexus-reports__compare-control",
      "name": "sales-reports-period-comparison-visible"
    },
    {
      "action": "screenshot",
      "name": "04b-relatorios-p2-p3"
    },
    {
      "action": "click",
      "text": "Por produto",
      "exact": true,
      "name": "sales-reports-product-tab"
    },
    {
      "action": "expectVisible",
      "name": "sales-reports-filters-visible",
      "selector": ".nexus-reports__filters"
    },
    {
      "action": "screenshot",
      "name": "04a-relatorios-produtos"
    },
    {
      "action": "click",
      "text": "Itens vendidos",
      "exact": true,
      "name": "sales-reports-items-tab"
    },
    {
      "action": "screenshot",
      "name": "04-vendas-e-relatorios"
    },
    {
      "action": "click",
      "selector": "a[href=\"#/financeiro\"]",
      "name": "open-cadastros-financeiros"
    },
    {
      "action": "expectVisible",
      "text": "Acesso restrito",
      "exact": true,
      "name": "cashier-payment-methods-restricted"
    },
    {
      "action": "screenshot",
      "name": "04c-financeiro-cadastros"
    },
    {
      "action": "click",
      "selector": "a[href=\"#/fechamento\"]",
      "name": "open-blind-closing"
    },
    {
      "action": "expectVisible",
      "text": "Conferência de caixa",
      "exact": true,
      "name": "blind-cash-closing-visible"
    },
    {
      "action": "screenshot",
      "name": "04d-fechamento-caixa"
    },
    {
      "action": "click",
      "selector": "a[href=\"#/gestao\"]",
      "name": "cashier-gestao-is-restricted"
    },
    {
      "action": "expectVisible",
      "text": "Acesso restrito",
      "exact": true,
      "name": "cashier-cannot-see-financial-data"
    },
    {
      "action": "click",
      "selector": "a[href=\"#/configuracoes\"]",
      "name": "configure-first-manager-for-qa"
    },
    {
      "action": "fill",
      "selector": "input[placeholder=\"Senha/PIN do operador\"]",
      "value": "QA-test-manager-only-2026",
      "name": "set-manager-test-pin"
    },
    {
      "action": "click",
      "text": "Configurar gerente inicial",
      "exact": true,
      "name": "bootstrap-manager-local-qa"
    },
    {
      "action": "expectVisible",
      "text": "Gerente inicial configurado.",
      "exact": false,
      "name": "bootstrap-manager-confirmation"
    },
    {
      "action": "click",
      "selector": "a[href=\"#/gestao\"]",
      "name": "open-canonical-gestao"
    },
    {
      "action": "expectURL",
      "includes": "#/gestao",
      "name": "gestao-route"
    },
    {
      "action": "expectVisible",
      "name": "commercial-dashboard",
      "selector": "[data-pdv-commercial-panel=\"true\"] h2"
    },
    {
      "action": "expectVisible",
      "text": "Cadastrar fornecedor",
      "exact": true,
      "name": "supplier-registration"
    },
    {
      "action": "expectVisible",
      "text": "Nova compra · adicionar itens",
      "exact": true,
      "name": "purchase-entry-form"
    },
    {
      "action": "screenshot",
      "name": "05a-compras-fornecedores"
    },
    {
      "action": "click",
      "selector": "a[href=\"#/financeiro\"]",
      "name": "open-payables"
    },
    {
      "action": "expectVisible",
      "text": "Registrar pagamento ou recebimento parcial",
      "exact": true,
      "name": "ledger-settlements"
    },
    {
      "action": "screenshot",
      "name": "05b-financeiro-gerencial"
    },
    {
      "action": "click",
      "selector": "a[href=\"#/gestao\"]",
      "name": "return-to-commercial-for-profit"
    },
    {
      "action": "click",
      "text": "Lucratividade",
      "exact": true,
      "name": "open-commercial-profit"
    },
    {
      "action": "expectVisible",
      "text": "Lucratividade por venda",
      "exact": false,
      "name": "gross-profit-visible"
    },
    {
      "action": "screenshot",
      "name": "05c-lucratividade"
    },
    {
      "action": "click",
      "selector": "a[href=\"#/administracao\"]",
      "name": "open-administracao"
    },
    {
      "action": "expectURL",
      "includes": "#/administracao",
      "name": "administracao-route"
    },
    {
      "action": "waitForTimeout",
      "timeoutMs": 250,
      "name": "administracao-render"
    },
    {
      "action": "screenshot",
      "name": "05-administracao"
    },
    {
      "action": "click",
      "selector": "a[href=\"#/balanca\"]",
      "name": "open-balanca"
    },
    {
      "action": "expectURL",
      "includes": "#/balanca",
      "name": "balanca-route"
    },
    {
      "action": "waitForTimeout",
      "timeoutMs": 250,
      "name": "balanca-render"
    },
    {
      "action": "screenshot",
      "name": "06-balanca"
    },
    {
      "action": "click",
      "selector": "a[href=\"#/configuracoes\"]",
      "name": "open-configuracoes"
    },
    {
      "action": "expectURL",
      "includes": "#/configuracoes",
      "name": "configuracoes-route"
    },
    {
      "action": "waitForTimeout",
      "timeoutMs": 250,
      "name": "configuracoes-render"
    },
    {
      "action": "screenshot",
      "name": "07-configuracoes"
    },
    {
      "action": "click",
      "selector": "a[href=\"#/financeiro\"]",
      "name": "open-financeiro-contas"
    },
    {
      "action": "expectURL",
      "includes": "#/financeiro",
      "name": "financeiro-contas-route"
    },
    {
      "action": "expectVisible",
      "text": "Registrar pagamento ou recebimento parcial",
      "exact": true,
      "name": "financeiro-contas-receber"
    },
    {
      "action": "expectVisible",
      "name": "financeiro-saldos-a-pagar",
      "selector": "[data-pdv-finance-kpi=\"payable\"]"
    },
    {
      "action": "click",
      "text": "Kanban",
      "exact": true,
      "name": "open-finance-kanban"
    },
    {
      "action": "expectVisible",
      "selector": "[data-pdv-kanban=\"true\"]",
      "name": "finance-kanban-columns"
    },
    {
      "action": "expectVisible",
      "selector": "[data-pdv-kanban-column=\"vencidas\"]",
      "name": "finance-overdue-lane"
    },
    {
      "action": "screenshot",
      "name": "08b-financeiro-kanban"
    },
    {
      "action": "click",
      "text": "Relatórios",
      "exact": true,
      "name": "open-finance-reports"
    },
    {
      "action": "expectVisible",
      "text": "Excel XLSX",
      "exact": true,
      "name": "finance-xlsx-export"
    },
    {
      "action": "expectVisible",
      "text": "PDF",
      "exact": true,
      "name": "finance-pdf-export"
    },
    {
      "action": "screenshot",
      "name": "08c-financeiro-relatorios"
    },
    {
      "action": "click",
      "text": "Matriz financeira",
      "exact": true,
      "name": "return-to-finance-matrix"
    },
    {
      "action": "expectVisible",
      "selector": "[data-pdv-finance-panel=\"true\"] table",
      "name": "finance-matrix-visible"
    },
    {
      "action": "screenshot",
      "name": "08-financeiro-contas"
    },
    {
      "action": "click",
      "selector": "a[href=\"#/gestao\"]",
      "name": "open-gestao-comercial"
    },
    {
      "action": "expectVisible",
      "text": "Cadastrar fornecedor",
      "exact": true,
      "name": "gestao-compras-continua"
    },
    {
      "action": "screenshot",
      "name": "09-gestao-compras"
    }
  ]
}
