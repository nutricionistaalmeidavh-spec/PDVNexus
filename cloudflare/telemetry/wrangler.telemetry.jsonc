{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pdv-nexus-telemetry",
  "main": "src/index.js",
  "compatibility_date": "2026-09-28",
  "workers_dev": true,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "pdv-nexus-telemetry",
      "database_id": "REPLACE_WITH_DEDICATED_TELEMETRY_D1_ID"
    }
  ]
}
