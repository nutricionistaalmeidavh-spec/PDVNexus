{
  "id": "pdv-demo",
  "steps": [
    { "action": "waitFor", "selector": "a[href=\"#/caixa\"]", "name": "pdv-ready", "timeoutMs": 20000, "holdMs": 700 },
    { "action": "expectVisible", "text": "PDV Nexus", "exact": true, "name": "brand-visible", "holdMs": 500 },
    { "action": "waitFor", "selector": "[data-cashier-client-icon=\"true\"]", "name": "client-card-icon", "timeoutMs": 5000 },
    { "action": "waitFor", "selector": "[data-cashier-seller-icon=\"true\"]", "name": "seller-card-icon", "timeoutMs": 5000 },
    { "action": "screenshot", "name": "01-demo-inicio" },

    { "action": "click", "text": "Abrir caixa", "exact": true, "name": "abrir-caixa", "holdMs": 900 },
    { "action": "expectVisible", "selector": "button:has-text(\"Caixa aberto\")", "name": "caixa-aberto", "holdMs": 600 },
    { "action": "screenshot", "name": "02-caixa-aberto" },

    { "action": "click", "selector": "button:has-text(\"Nova venda\")", "name": "nova-venda", "holdMs": 900 },
    { "action": "expectVisible", "text": "Venda aberta. Adicione produtos.", "exact": true, "name": "venda-iniciada", "holdMs": 500 },

    { "action": "fill", "selector": "input[placeholder*=\"Bipe\"]", "value": "00101", "name": "digitar-produto", "holdMs": 500 },
    { "action": "press", "selector": "input[placeholder*=\"Bipe\"]", "key": "Enter", "name": "adicionar-produto", "holdMs": 900 },
    { "action": "expectVisible", "text": "1 UN x R$ 100,00", "exact": true, "name": "produto-no-carrinho", "holdMs": 500 },
    { "action": "expectVisible", "selector": "[data-cashier-footer=\"sale-actions\"]", "name": "rodape-operacional", "holdMs": 300 },
    { "action": "expectVisible", "text": "Qtd. total", "exact": true, "name": "quantidade-total-visible", "holdMs": 300 },
    { "action": "click", "text": "Cancelar item", "exact": true, "name": "cancelar-item", "holdMs": 700 },
    { "action": "expectVisible", "text": "Venda aberta. Adicione produtos.", "exact": true, "name": "item-cancelado", "holdMs": 400 },

    { "action": "fill", "selector": "input[placeholder*=\"Bipe\"]", "value": "00101", "name": "repor-produto-apos-cancelar", "holdMs": 350 },
    { "action": "press", "selector": "input[placeholder*=\"Bipe\"]", "key": "Enter", "name": "adicionar-novamente", "holdMs": 650 },
    { "action": "expectVisible", "text": "1 UN x R$ 100,00", "exact": true, "name": "produto-reposto", "holdMs": 350 },
    { "action": "click", "text": "Limpar venda", "exact": true, "name": "limpar-venda", "holdMs": 700 },
    { "action": "expectVisible", "text": "Venda aberta. Adicione produtos.", "exact": true, "name": "venda-limpa", "holdMs": 400 },
    { "action": "screenshot", "name": "03-rodape-operacional" },

    { "action": "fill", "selector": "input[placeholder*=\"Bipe\"]", "value": "00101", "name": "produto-venda-final", "holdMs": 350 },
    { "action": "press", "selector": "input[placeholder*=\"Bipe\"]", "key": "Enter", "name": "adicionar-produto-final", "holdMs": 700 },
    { "action": "expectVisible", "text": "1 UN x R$ 100,00", "exact": true, "name": "produto-final-no-carrinho", "holdMs": 400 },
    { "action": "screenshot", "name": "04-produto-adicionado" },

    { "action": "press", "selector": "input[placeholder*=\"Bipe\"]", "key": "F6", "name": "pagamento-a-vista", "holdMs": 900 },
    { "action": "expectVisible", "selector": "input[type=\"number\"][value=\"100\"]", "name": "pagamento-registrado", "holdMs": 400 },
    { "action": "screenshot", "name": "05-pagamento" },

    { "action": "press", "selector": "input[placeholder*=\"Bipe\"]", "key": "F8", "name": "finalizar-venda", "holdMs": 1400 },
    { "action": "expectVisible", "selector": "[role=\"dialog\"][aria-label=\"Comprovante da venda\"]", "name": "comprovante-aberto", "holdMs": 800 },
    { "action": "screenshot", "name": "06-venda-finalizada" },
    { "action": "click", "text": "Fechar", "exact": true, "name": "fechar-comprovante", "holdMs": 500 },

    { "action": "click", "selector": "a[href=\"#/financeiro\"]", "name": "abrir-financeiro", "holdMs": 800 },
    { "action": "expectVisible", "text": "Resumo local das vendas finalizadas", "exact": true, "name": "financeiro-aberto", "holdMs": 350 },
    { "action": "expectText", "selector": ":nth-match(article:has(h2:has-text(\"Resumo local das vendas finalizadas\")) strong, 2)", "expected": "100,00", "name": "financeiro-total-vendido", "holdMs": 250 },
    { "action": "screenshot", "name": "07-financeiro-pos-venda" }
  ]
}
