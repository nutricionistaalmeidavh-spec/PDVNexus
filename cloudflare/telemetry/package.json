{
  "name": "@pdv-nexus/telemetry-cloudflare",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "check": "node --check src/index.js && node --check src/schema.js && node --check src/auth.js && node --check src/storage.js",
    "deploy": "npx wrangler deploy",
    "deploy:isolated": "npx wrangler deploy --config wrangler.telemetry.jsonc",
    "dev": "npx wrangler dev",
    "dev:isolated": "npx wrangler dev --config wrangler.telemetry.jsonc"
  },
  "devDependencies": {
    "wrangler": "^4.140.0"
  }
}
