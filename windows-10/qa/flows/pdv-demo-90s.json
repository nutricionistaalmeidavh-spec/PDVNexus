{
  "id": "pdv-demo-90s",
  "steps": [
    {"action":"waitFor","selector":"a[href=\"#/caixa\"]","name":"pdv-ready","timeoutMs":20000,"holdMs":1200},
    {"action":"expectVisible","text":"PDV Nexus","exact":true,"name":"brand-visible","holdMs":800},
    {"action":"click","selector":"a[href=\"#/produtos\"]","name":"abrir-produtos","holdMs":5000},
    {"action":"expectURL","includes":"#/produtos","name":"produtos-route"},
    {"action":"expectVisible","text":"Picanha Bovina","exact":true,"name":"produto-demo-visivel","holdMs":2500},
    {"action":"screenshot","name":"01-catalogo-completo"},
    {"action":"click","selector":"article:has(h2:text-is(\"Estoque\")) button[aria-expanded=\"false\"]","name":"abrir-estoque","holdMs":4000},
    {"action":"expectVisible","selector":"article:has(h2:text-is(\"Estoque\")) tbody tr:has-text(\"Arroz Tipo 1 5kg\")","name":"estoque-historico-visivel","holdMs":1800},
    {"action":"screenshot","name":"02-estoque-demo"},
    {"action":"click","selector":"a[href=\"#/clientes\"]","name":"abrir-clientes","holdMs":4500},
    {"action":"expectURL","includes":"#/clientes","name":"clientes-route"},
    {"action":"expectVisible","text":"Joao Santos","exact":true,"name":"cliente-demo-visivel","holdMs":2500},
    {"action":"screenshot","name":"03-clientes-demo"},
    {"action":"click","selector":"a[href=\"#/caixa\"]","name":"abrir-caixa-tela","holdMs":4000},
    {"action":"expectURL","includes":"#/caixa","name":"caixa-route"},
    {"action":"click","text":"Abrir caixa","exact":true,"name":"abrir-caixa","holdMs":2200},
    {"action":"expectVisible","selector":"button:has-text(\"Caixa aberto\")","name":"caixa-aberto","holdMs":1200},
    {"action":"selectOption","selector":"aside > select","value":"CLI-002","name":"selecionar-cliente","holdMs":1600},
    {"action":"click","selector":"button:has-text(\"Nova venda\")","name":"nova-venda","holdMs":2200},
    {"action":"expectVisible","text":"Venda aberta. Adicione produtos.","exact":true,"name":"venda-iniciada","holdMs":800},
    {"action":"fill","selector":"input[placeholder*=\"Bipe\"]","value":"00103","name":"digitar-coca","holdMs":600},
    {"action":"press","selector":"input[placeholder*=\"Bipe\"]","key":"Enter","name":"adicionar-coca","holdMs":1500},
    {"action":"fill","selector":"input[placeholder*=\"Bipe\"]","value":"00021","name":"digitar-picanha","holdMs":600},
    {"action":"press","selector":"input[placeholder*=\"Bipe\"]","key":"Enter","name":"adicionar-picanha","holdMs":1500},
    {"action":"fill","selector":"input[placeholder*=\"Bipe\"]","value":"00034","name":"digitar-tomate","holdMs":600},
    {"action":"press","selector":"input[placeholder*=\"Bipe\"]","key":"Enter","name":"adicionar-tomate","holdMs":1500},
    {"action":"fill","selector":"input[placeholder*=\"Bipe\"]","value":"00102","name":"digitar-mouse","holdMs":600},
    {"action":"press","selector":"input[placeholder*=\"Bipe\"]","key":"Enter","name":"adicionar-mouse","holdMs":2500},
    {"action":"fill","selector":"section[aria-label=\"Observação da venda\"] textarea","value":"Separar em duas sacolas; cliente retira a segunda parte amanhã às 10h.","name":"observacao-venda","holdMs":3500},
    {"action":"screenshot","name":"04-venda-completa"},
    {"action":"click","text":"PIX","exact":true,"name":"pagamento-pix","holdMs":4200},
    {"action":"screenshot","name":"05-pagamento"},
    {"action":"press","selector":"input[placeholder*=\"Bipe\"]","key":"F8","name":"finalizar-venda","holdMs":2500},
    {"action":"expectVisible","selector":"[role=\"dialog\"][aria-label=\"Comprovante da venda\"]","name":"comprovante","holdMs":6500},
    {"action":"expectText","selector":"[role=\"dialog\"][aria-label=\"Comprovante da venda\"] pre","expected":"Mercado Nexus Demo","name":"loja-no-cupom","holdMs":1200},
    {"action":"screenshot","name":"06-cupom-nao-fiscal"},
    {"action":"click","text":"Fechar","exact":true,"name":"fechar-comprovante","holdMs":1800},
    {"action":"click","selector":"a[href=\"#/financeiro\"]","name":"abrir-financeiro","holdMs":6500},
    {"action":"expectURL","includes":"#/financeiro","name":"financeiro-route"},
    {"action":"expectVisible","text":"Resumo local das vendas finalizadas","exact":true,"name":"resumo-financeiro","holdMs":4500},
    {"action":"screenshot","name":"07-financeiro-dashboard"}
  ]
}
