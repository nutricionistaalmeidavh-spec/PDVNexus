{
  "schemaVersion": 1,
  "systemId": "pdv-nexus-demo",
  "mode": "electron",
  "defaultEnvironment": "local",
  "defaultViewport": "desktop",
  "launchTimeoutMs": 45000,
  "capture": {
    "video": true,
    "fps": 4,
    "screenshotEachStep": false
  },
  "environments": {
    "local": {
      "env": {
        "NEXUS_APP": "pdv-demo"
      }
    }
  },
  "electron": {
    "entry": "pdv-demo-ephemeral-entry.cjs",
    "executablePath": "../node_modules/electron/dist/electron.exe",
    "env": {
      "NEXUS_APP": "pdv-demo"
    }
  },
  "demos": {
    "checkout-flow": {
      "file": "flows/pdv-demo.json",
      "preset": "landscape-16x9",
      "durationTargetSec": 24,
      "captureViewport": {
        "width": 1440,
        "height": 960
      }
    },
    "commercial-flow-90s": {
      "file": "flows/pdv-demo-90s.json",
      "preset": "landscape-16x9",
      "durationTargetSec": 90,
      "captureViewport": {
        "width": 1440,
        "height": 960
      }
    },
    "quick-sale-tutorial-20s": {
      "file": "flows/pdv-tutorial-20s.json",
      "preset": "landscape-16x9",
      "durationTargetSec": 20,
      "captureViewport": {
        "width": 1440,
        "height": 960
      }
    },
    "cash-open-close-tutorial": {
      "file": "flows/tutorial-caixa-abertura-fechamento.json",
      "preset": "landscape-16x9",
      "durationTargetSec": 20,
      "captureViewport": {
        "width": 1440,
        "height": 960
      }
    },
    "stock-adjustment-tutorial": {
      "file": "flows/tutorial-estoque-consulta-ajuste.json",
      "preset": "landscape-16x9",
      "durationTargetSec": 20,
      "captureViewport": {
        "width": 1440,
        "height": 960
      }
    },
    "customer-register-tutorial": {
      "file": "flows/tutorial-cliente-cadastro.json",
      "preset": "landscape-16x9",
      "durationTargetSec": 20,
      "captureViewport": {
        "width": 1440,
