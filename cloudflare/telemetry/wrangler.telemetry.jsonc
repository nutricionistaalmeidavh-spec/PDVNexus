{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pdv-nexus-telemetry",
  "main": "src/index.js",
  "compatibility_date": "2026-09-28",
  "workers_dev": true,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "pdv-nexus-telemetry",
      // Placeholder seguro para CI/dry-run. Substituir somente pelo ID de um D1 dedicado de telemetria antes do deploy real.
      "database_id": "00000000-0000-0000-0000-000000000000"
    }
  ]
}
