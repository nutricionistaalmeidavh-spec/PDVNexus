{
  "id": "pdv-tutorial-real-consulta-ajuste-estoque",
  "steps": [
    {
      "action": "waitFor",
      "selector": "a[href=\"#/caixa\"]",
      "name": "pdv-ready",
      "timeoutMs": 20000
    },
    {
      "action": "desktopStoreSet",
      "key": "nexus-core:pdv-store:v1",
      "name": "reset-pdv",
      "value": {}
    },
    {
      "action": "reload",
      "name": "reload-reset"
    },
    {
      "action": "waitFor",
      "selector": "a[href=\"#/caixa\"]",
      "name": "pdv-reset-ready",
      "timeoutMs": 20000
    },
    {
      "action": "click",
      "selector": "a[href=\"#/produtos\"]",
      "name": "open-produtos",
      "holdMs": 650
    },
    {
      "action": "expectURL",
      "includes": "#/produtos",
      "name": "produtos-route",
      "holdMs": 500
    },
    {
      "action": "click",
      "name": "abrir-estoque",
      "holdMs": 650,
      "selector": "article:has(h2:text-is(\"Estoque\")) button[aria-expanded=\"false\"]"
    },
    {
      "action": "selectOption",
      "selector": "select:has(option[value=\"00101\"])",
      "value": "00101",
      "name": "produto-teclado",
      "holdMs": 650
    },
    {
      "action": "selectOption",
      "selector": "select:has(option[value=\"entry\"])",
      "value": "entry",
      "name": "tipo-entrada",
      "holdMs": 650
    },
    {
      "action": "fill",
      "selector": "input[placeholder=\"Quantidade\"]",
      "value": "4",
      "name": "quantidade",
      "holdMs": 650
    },
    {
      "action": "fill",
      "selector": "input[placeholder=\"Motivo\"]",
      "value": "Compra fornecedor QA",
      "name": "motivo",
      "holdMs": 650
    },
    {
      "action": "click",
      "text": "Revisar movimento",
      "exact": true,
      "name": "abrir-revisao-movimento",
      "holdMs": 650
    },
    {
      "action": "click",
      "text": "Confirmar movimento",
      "exact": true,
      "name": "confirmar-movimento",
      "holdMs": 650
    },
    {
      "action": "waitForTimeout",
      "timeoutMs": 300,
      "name": "persistir"
    },
    {
      "action": "expectDesktopStoreJson",
      "key": "nexus-core:pdv-store:v1",
      "path": "catalogProducts.2.stock",
      "expected": 12,
      "name": "estoque-entrada"
    },
    {
      "action": "expectDesktopStoreJson",
      "key": "nexus-core:pdv-store:v1",
      "path": "extensions.inventoryMovements.0.type",
      "expected": "entry",
      "name": "movimento-entrada"
    }
  ]
}
