{
  "schemaVersion": 1,
  "systemId": "pdv-nexus-tutoriais-reais",
  "mode": "electron",
  "defaultEnvironment": "local",
  "defaultViewport": "desktop",
  "launchTimeoutMs": 45000,
  "capture": {
    "video": true,
    "fps": 4,
    "screenshotEachStep": false
  },
  "environments": {
    "local": {
      "env": {
        "NEXUS_APP": "pdv-demo"
      }
    }
  },
  "electron": {
    "entry": "pdv-demo-ephemeral-entry.cjs",
    "executablePath": "../node_modules/electron/dist/electron.exe",
    "env": {
      "NEXUS_APP": "pdv-demo"
    }
  },
  "demos": {
    "produto-primeira-venda": {
      "file": "flows/tutorial-produto-primeira-venda.json",
      "preset": "landscape-16x9",
      "durationTargetSec": 68,
      "captureViewport": {
        "width": 1440,
        "height": 960
      }
    },
    "abrir-fechar-caixa": {
      "file": "flows/tutorial-abrir-fechar-caixa.json",
      "preset": "landscape-16x9",
      "durationTargetSec": 55,
      "captureViewport": {
        "width": 1440,
        "height": 960
      }
    },
    "cliente-cadastro": {
      "file": "flows/tutorial-cliente-cadastro.json",
      "preset": "landscape-16x9",
      "durationTargetSec": 34,
      "captureViewport": {
        "width": 1440,
        "height": 960
      }
    },
    "consulta-ajuste-estoque": {
      "file": "flows/tutorial-consulta-ajuste-estoque.json",
      "preset": "landscape-16x9",
      "durationTargetSec": 34,
      "captureViewport": {
